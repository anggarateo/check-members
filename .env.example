# PostgreSQL connection.
# Neon: copy both URLs from the dashboard (Connect). The app uses the pooled one.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct connection (without "-pooler"). Used by the scripts (migrate, import, token).
# Optional: if empty, the scripts use DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Local Docker alternative:
# DATABASE_URL=postgres://member:member@localhost:5432/member_check

# Public URL of the app, used by the token script to print the link
APP_URL=http://localhost:3000

# Search limit per IP per minute
RATE_LIMIT_PER_MINUTE=20
